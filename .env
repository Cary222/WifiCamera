# Application Environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# API Configuration (SkySense backend server)
EXPO_PUBLIC_API_URL=https://your-skysense-backend.com/api

# WifiCamera device HTTP API (legacy firmware, LAN cleartext).
# Override when the camera is reachable at a non-default address.
# EXPO_PUBLIC_CAMERA_BASE_URL=http://192.168.1.1:8999

# Expo Build Configuration
EXPO_PUBLIC_EAS_PROJECT_ID=13d38557-f618-4a12-812f-4505aea6929f
EXPO_PUBLIC_SLUG=skysense

# Example Variables
EXPO_PUBLIC_VAR_NUMBER=10
EXPO_PUBLIC_VAR_BOOL=true

# Build-time only secrets (no EXPO_PUBLIC prefix - NOT accessible in src folder)
SECRET_KEY=my-secret-key
APP_BUILD_ONLY_VAR=build-only-value
