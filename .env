# Application Environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# API Configuration (SkySense backend server)
EXPO_PUBLIC_API_URL=https://your-skysense-backend.com/api

# USB ADB test mode: MuMu -> 10.0.2.2:18999 -> adb forward -> board 8999.
# Recreate this mapping after reconnecting the board:
# adb -s e2621126569ad4a5 forward tcp:18999 tcp:8999
EXPO_PUBLIC_CAMERA_BASE_URL=http://10.0.2.2:18999
# USB WHEP relay: relay rewrites ICE candidates to MuMu's host gateway and
# carries MediaMTX UDP packets through board_webrtc_udp_tunnel over ADB USB.
EXPO_PUBLIC_CAMERA_WHEP_URL=http://10.0.2.2:18787/board-webrtc/cam0/whep

# Expo Build Configuration
EXPO_PUBLIC_EAS_PROJECT_ID=13d38557-f618-4a12-812f-4505aea6929f
EXPO_PUBLIC_SLUG=skysense

# Example Variables
EXPO_PUBLIC_VAR_NUMBER=10
EXPO_PUBLIC_VAR_BOOL=true

# Build-time only secrets (no EXPO_PUBLIC prefix - NOT accessible in src folder)
SECRET_KEY=my-secret-key
APP_BUILD_ONLY_VAR=build-only-value
